# Copy to `.env` and fill values as stories require them.
# Story 0.1 needs almost no configuration; the commented entries below document
# what LATER stories will need, so there are no surprises. Do not commit `.env`.

APP_ENV=local

# Story 0.4 (DB). Defaults to the docker-compose Postgres if unset.
# Host dev: run `make up` first (starts Postgres on localhost:5432), then `make migrate`.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/hiring

# Story 1.2 (auth). A dev default exists in Settings; MUST override in prod (TD-005).
# JWT_SECRET=change-me-to-a-long-random-string

# Story 5.1/5.3 (AI evaluation). Default `mock` = deterministic in-process provider
# (no network, no cost). A real provider requires its key and NEVER silently falls back to
# mock. Keep keys out of version control.
# AI_PROVIDER=mock|anthropic|gemini
#
# --- Anthropic (paid) ---
# ANTHROPIC_API_KEY=                       # required only when AI_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5          # exact id is recorded in evaluation provenance
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_RETRIES=2                  # SDK-managed → up to 3 attempts per request
#
# --- Gemini (free tier) — ⚠️ SYNTHETIC DATA ONLY ---
# The Gemini free tier may use submitted content to improve Google's products, so it is
# ONLY for the synthetic A-G quality fixtures — NEVER real candidate Evidence (TD-017).
# GEMINI_API_KEY=                          # required only when AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash            # exact id is recorded in evaluation provenance
# GEMINI_TIMEOUT_SECONDS=60

# RESEND_API_KEY=                          # Story 4.1 / 10.1 (email)
# R2_ACCOUNT_ID=                           # Story 3.1 / 10.1 (object storage)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# SENTRY_DSN=                              # Story 10.2 (error tracking)
