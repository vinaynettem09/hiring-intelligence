# Production environment TEMPLATE (Story 9.1) — placeholders only, NO real secrets.
# These values are set in the hosting dashboards (Render for backend, Vercel for frontend),
# never committed. See docs/deployment.md for the full matrix and where each comes from.

# ===== BACKEND (Render service env) =====
APP_ENV=production

# PostgreSQL (Neon). Must be the asyncpg URL and include sslmode=require.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Auth — generate a long random secret: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# Candidate magic links are built from this — MUST be the public frontend (Vercel) URL.
FRONTEND_BASE_URL=https://YOUR-APP.vercel.app

# Email (transactional SMTP, e.g. Brevo). Real values only in the dashboard.
EMAIL_FROM=Hiring Intelligence <you@example.com>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_USE_TLS=true

# AI provider. "mock" = safe default (no data leaves, labelled in UI). Set "gemini" + key
# only after deciding on candidate-data retention (free tier may train on submissions).
AI_PROVIDER=mock
GEMINI_API_KEY=

# ===== FRONTEND (Vercel project env, build-time) =====
# Points the Next.js /api/* rewrite proxy at the deployed backend. NOT a secret.
BACKEND_URL=https://YOUR-BACKEND.onrender.com
